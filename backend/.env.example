# ============================================================
# GoalMGMT - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database (Supabase) ---
# Find this in your Supabase Dashboard -> Settings -> Database -> Connection String (URI)
# Use the "Transaction" connection string (port 6543) for serverless/pooled connections,
# or the "Session" string (port 5432) for long-lived connections like migrations.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Authentication (JWT) ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google Gemini API ---
GEMINI_API_KEY=your-gemini-api-key

# --- Resend (Email) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# --- Cron Security ---
# A secret key used to authenticate requests to the /api/cron/* endpoints.
CRON_SECRET_KEY=your-cron-secret-key

# --- App ---
APP_NAME=GoalMGMT
FRONTEND_URL=http://localhost:3000
